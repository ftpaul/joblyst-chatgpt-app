# Copy to .env.local and fill in real values.
# Read by src/joblyst.ts (Supabase access) and src/auth.ts (dev bypass).

SUPABASE_URL=https://hyilnfdqgvhydjhjqznu.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# DEV ONLY — your own mcp_api_key (UUID) from joblyst.tech/account.
# In dev, Skybridge DevTools has no OAuth flow, so handlers fall back to this
# key to load YOUR profile. Production deploys ignore this var entirely and
# enforce Bearer auth via requireBearerAuth.
DEV_PROFILE_API_KEY=
